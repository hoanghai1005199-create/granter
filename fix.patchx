+    private val lastLocal = java.util.concurrent.atomic.AtomicLong(0)
+    private val lastLocalState = java.util.concurrent.atomic.AtomicReference(State.OFFLINE)
+    private const val LOCAL_CACHE_MS = 8000L
+
+    /** Cache nhẹ: gọi nhiều lần trong 8s không verify lại. */
+    fun localCached(c: Context): State {
+        val now = SystemClock.elapsedRealtime()
+        val last = lastLocal.get()
+        if (now - last in 0 until LOCAL_CACHE_MS) {
+            return lastLocalState.get()!!
+        }
+        val s = local(c)
+        lastLocal.set(now)
+        lastLocalState.set(s)
+        return s
+    }
+
